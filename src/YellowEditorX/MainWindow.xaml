<Window x:Class="YellowEditorX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YellowEditorX" Icon="app.ico" Width="1500" Height="900" WindowState="Maximized"
        Background="{StaticResource Bg}" UseLayoutRounding="True"
        AllowDrop="True" PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        TextOptions.TextFormattingMode="Display">
    <DockPanel x:Name="Root">
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="NewButton" Style="{StaticResource Tool}" Click="NewCard_Click" ToolTip="새 카드 (Ctrl+N)">＋ 새 카드</Button>
                    <Button x:Name="DuplicateButton" Style="{StaticResource Tool}" Click="Duplicate_Click" ToolTip="지금 카드를 다음 빈 코드로 복제 (Ctrl+D)">⧉ 복제</Button>
                    <Button x:Name="SaveButton" Style="{StaticResource Primary}" Click="Save_Click" ToolTip="저장 (Ctrl+S)" Margin="4,0,8,0">저장</Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource Tool}" Click="Delete_Click" ToolTip="목록에서 선택한 카드 삭제 (Delete)">삭제</Button>
                    <Button x:Name="UndoButton" Style="{StaticResource Tool}" Click="Undo_Click" ToolTip="마지막 저장·삭제·복사 되돌리기 (Ctrl+Z)">↶ 되돌리기</Button>
                    <Rectangle Width="1" Fill="{StaticResource Line}" Margin="8,4"/>
                    <Button Style="{StaticResource Tool}" Click="Script_Click" ToolTip="스크립트 열기 — 없으면 만듭니다 (Ctrl+L)">스크립트</Button>
                    <Button Style="{StaticResource Tool}" Click="ImportImage_Click" ToolTip="카드 이미지 가져오기 (Ctrl+I)">이미지</Button>
                    <Button Style="{StaticResource Tool}" Click="OpenFolder_Click" ToolTip="이 DB가 있는 폴더 열기">폴더</Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="ZoomText" Style="{StaticResource Label}" ToolTip="Ctrl + 마우스 휠, Ctrl+= / Ctrl+- / Ctrl+0"/>
                    <Button Style="{StaticResource Tool}" Click="ZoomOut_Click">－</Button>
                    <Button Style="{StaticResource Tool}" Click="ZoomIn_Click">＋</Button>
                    <Button Style="{StaticResource Tool}" Click="SyncRemote_Click"
                            ToolTip="CyanPro GitHub에서 카드군(CyanPro_CardDB/strings.conf)과 종족·속성(CyanPro ocgapi_constants.h)을 다시 받아요. 켤 때도 자동으로 받아요">목록 갱신</Button>
                    <Button Style="{StaticResource Tool}" Click="Help_Click">단축키</Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="DbPathText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid x:Name="Main" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="470" MinWidth="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.25*" MinWidth="520"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="StringsColumn" Width="0.8*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============ left: databases and cards ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Style="{StaticResource Small}" Click="NewDb_Click" ToolTip="새 cdb 만들기 (카드군 폴더와 pics, script 폴더도 같이 만듭니다)">새 DB</Button>
                                <Button Style="{StaticResource Small}" Click="OpenDb_Click" ToolTip="cdb 파일 열기 (여러 개를 한 번에 고를 수 있어요)" Margin="4,0,0,0">열기</Button>
                            </StackPanel>
                            <TextBlock Text="카드 DB" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="DbList" MaxHeight="230" BorderThickness="0" SelectionChanged="DbList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Path}" Background="Transparent">
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="CDB 닫기" Click="CloseDb_Click"/>
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown"
                                     ToolTip="지금 DB의 카드를 코드·이름·카드 텍스트(제작 정보 포함)·종류로 찾아요. 띄어쓰기로 여러 단어, Esc로 지우기 (Ctrl+F)"/>
                            <TextBlock Text="🔍 카드 검색 — 이름·카드 텍스트·코드·태그 (Ctrl+F)" Foreground="#9CA3AF" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=FilterBox, Converter={StaticResource Vis}}"/>
                        </Grid>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" Margin="2,6,0,0"/>
                        <ListView x:Name="CardList" BorderThickness="0" SelectionMode="Extended"
                                  SelectionChanged="CardList_SelectionChanged" KeyDown="CardList_KeyDown"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  GridViewColumnHeader.Click="CardList_HeaderClick">
                            <ListView.ContextMenu>
                                <ContextMenu x:Name="CardMenu" Opened="CardMenu_Opened">
                                    <MenuItem x:Name="CopyToMenu" Header="다른 DB로 복사"/>
                                    <MenuItem x:Name="MoveToMenu" Header="다른 DB로 이동"/>
                                    <Separator/>
                                    <MenuItem Header="삭제" Click="Delete_Click" InputGestureText="Delete"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="코드" Width="84" DisplayMemberBinding="{Binding Code}"/>
                                    <GridViewColumn Header="이름" Width="118" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="종류" Width="112" DisplayMemberBinding="{Binding Kind}"/>
                                    <GridViewColumn Header="레벨" Width="40" DisplayMemberBinding="{Binding LevelText}"/>
                                    <GridViewColumn Header="공 / 수" Width="76" DisplayMemberBinding="{Binding Stats}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" DragCompleted="Splitter_DragCompleted"/>

            <!-- ============ center: the card ============ -->
            <Grid Grid.Column="2" x:Name="Editor">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- name -->
                        <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="Bold" Padding="8,5"/>
                            <TextBlock Text="카드 이름" FontSize="22" Foreground="#B8BEC8" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=NameBox, Converter={StaticResource Vis}}"/>
                        </Grid>

                        <!-- image -->
                        <Border Grid.Row="1" x:Name="ImageBox" Width="216" Height="310" VerticalAlignment="Top" Margin="0,0,16,0"
                                CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#EEF0F4"
                                AllowDrop="True" Drop="Image_Drop" DragOver="Image_DragOver"
                                MouseLeftButtonDown="Image_MouseDown" MouseLeftButtonUp="Image_Click" Cursor="Hand"
                                ToolTip="클릭해서 이미지 고르기, 파일을 끌어다 놓기, 우클릭으로 붙여넣기">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="파일에서 가져오기..." Click="ImportImage_Click" InputGestureText="Ctrl+I"/>
                                    <MenuItem Header="클립보드에서 붙여넣기" Click="PasteImage_Click"/>
                                    <MenuItem Header="pics 폴더 열기" Click="OpenPics_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <TextBlock x:Name="NoImageText" Text="이미지 없음&#x0a;&#x0a;클릭하거나&#x0a;파일을 끌어다 놓으세요" TextAlignment="Center"
                                           Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <Image x:Name="CardImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <!-- fields -->
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Label}"/>
                            </Grid.Resources>

                            <TextBlock Text="코드"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="CodeBox" Width="120" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource Small}" Margin="6,0,0,0" Click="NextCode_Click" ToolTip="안 쓰는 다음 코드 (Ctrl+Shift+N) — 목록에 있는 모든 DB를 확인합니다">다음 빈 코드</Button>
                                <TextBlock Text="동명 취급" Margin="20,0,8,0"/>
                                <TextBox Width="120" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" ToolTip="같은 이름으로 취급할 카드 코드 (없으면 비워 두기)"/>
                                <CheckBox x:Name="HiddenBox" Content="숨김" IsChecked="{Binding IsHidden}" VerticalAlignment="Center" Margin="20,0,0,0"
                                          ToolTip="CyanPro 덱 편집기 검색에 안 나오게 해요 (SCOPE_HIDDEN, ot 0x1000). 스크립트로 만드는 카드 등에 써요."/>
                                <TextBlock x:Name="NewBadge" Text="새 카드" Foreground="White" Background="#16A34A" Padding="7,2" Margin="14,0,0,0"
                                           Visibility="{Binding IsNew, Converter={StaticResource Vis}}"/>
                                <TextBlock Text="● 저장 안 됨" Foreground="{StaticResource Warn}" Margin="14,0,0,0"
                                           Visibility="{Binding IsDirty, Converter={StaticResource Vis}}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="종류" VerticalAlignment="Top" Margin="0,5,8,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton Style="{StaticResource MainChip}" Content="몬스터" IsChecked="{Binding IsMonsterType}"/>
                                    <RadioButton Style="{StaticResource MainChip}" Content="마법" IsChecked="{Binding IsSpellType}"/>
                                    <RadioButton Style="{StaticResource MainChip}" Content="함정" IsChecked="{Binding IsTrapType}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SubTypes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource Chip}" Content="{Binding Text}" IsChecked="{Binding IsChecked}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock x:Name="AttributeLabel" Grid.Row="2" Text="속성"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <ComboBox Width="130" ItemsSource="{Binding Attributes}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Attribute}"/>
                                <TextBlock Text="종족" Margin="20,0,8,0"/>
                                <ComboBox Width="150" ItemsSource="{Binding Races}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Race}" IsTextSearchEnabled="True"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="{Binding LevelLabel}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Width="56" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Number_PreviewKeyDown"
                                         ToolTip="↑ / ↓ 키로 1씩 바꿀 수 있어요"/>
                                <TextBlock Text="공격력" Margin="20,0,8,0"/>
                                <TextBox Width="70" Text="{Binding Atk, UpdateSourceTrigger=PropertyChanged}" ToolTip="? 도 입력할 수 있어요"/>
                                <TextBlock Text="수비력" Margin="16,0,8,0" Visibility="{Binding IsLink, Converter={StaticResource NotVis}}"/>
                                <TextBox Width="70" Text="{Binding Def, UpdateSourceTrigger=PropertyChanged}" ToolTip="? 도 입력할 수 있어요"
                                         Visibility="{Binding IsLink, Converter={StaticResource NotVis}}"/>
                            </StackPanel>

                            <TextBlock x:Name="ScaleLabel" Grid.Row="4" Text="스케일" Visibility="{Binding IsPendulum, Converter={StaticResource Vis}}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10"
                                        Visibility="{Binding IsPendulum, Converter={StaticResource Vis}}">
                                <TextBlock Text="◀" Foreground="#2563EB" Margin="0,0,4,0"/>
                                <TextBox Width="48" Text="{Binding LScale, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Number_PreviewKeyDown"/>
                                <TextBox Width="48" Margin="10,0,4,0" Text="{Binding RScale, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Number_PreviewKeyDown"/>
                                <TextBlock Text="▶" Foreground="#DC2626"/>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Text="링크 마커" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="{Binding IsLink, Converter={StaticResource Vis}}"/>
                            <ItemsControl x:Name="MarkerGrid" Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Markers}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                          Visibility="{Binding IsLink, Converter={StaticResource Vis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource Marker}" Content="{Binding Text}" IsChecked="{Binding IsChecked}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Row="6" Text="카드군" VerticalAlignment="Top" Margin="0,5,8,0"/>
                            <ItemsControl Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Setcodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,10,6">
                                            <TextBox DockPanel.Dock="Left" Width="58" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="카드군 번호 (16진수)" FontFamily="Consolas"/>
                                            <ComboBox Margin="4,0,0,0" ItemsSource="{Binding Names}" DisplayMemberPath="Text"
                                                      SelectedItem="{Binding Selected}" IsTextSearchEnabled="True"
                                                      ToolTip="목록을 연 채로 이름 첫 글자를 치면 이동해요"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 제작 정보: the first four are written at the end of the card text, the dates only to the card_dates table -->
                            <TextBlock Grid.Row="7" Text="제작 정보" VerticalAlignment="Top" Margin="0,5,8,0"/>
                            <Grid x:Name="FooterFields" Grid.Row="7" Grid.Column="1" Margin="0,4,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="제작자"/>
                                <TextBox x:Name="MakerBox" Grid.Column="1" Margin="0,0,0,6" Text="{Binding Maker, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="카드 텍스트 끝 첫 줄에 [제작자]로 들어가요 (도감 사이트는 첫 줄을 제작자로 읽어요). 새 카드에는 마지막으로 쓴 이름이 채워져요"/>
                                <TextBlock Grid.Column="2" Text="태그" Margin="14,0,8,0"/>
                                <TextBox x:Name="TagsBox" Grid.Column="3" Margin="0,0,0,6" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="[태그: 태그1 | 태그2]로 들어가요. 여러 개는 | 로 구분해 주세요 (쉼표는 태그 내용으로 그대로 남아요)"/>
                                <TextBlock Grid.Row="1" Text="팩 이름"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding Pack, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="[팩 이름]으로 들어가요"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="카드 번호" Margin="14,0,8,0"/>
                                <TextBox x:Name="NumberBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="ABCD-AM001 형식 (영문 대문자·숫자 3~6자 - 영문 대문자 2자 + 숫자 3자리). 도감 사이트는 이 번호로 팩을 묶어요" FontFamily="Consolas"/>
                                <TextBlock Grid.Row="2" Text="제작일"/>
                                <TextBox x:Name="CreatedBox" Grid.Row="2" Grid.Column="1" Text="{Binding Created, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="yyyy-mm-dd. 새 카드를 처음 저장하면 오늘 날짜가 들어가요. YGOPro에는 안 보여요" FontFamily="Consolas"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="수정일" Margin="14,0,8,0"/>
                                <TextBox x:Name="ModifiedBox" Grid.Row="2" Grid.Column="3" Text="{Binding Modified, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="yyyy-mm-dd. 고쳐서 저장할 때마다 오늘 날짜로 바뀌어요 (직접 고친 경우는 그대로). YGOPro에는 안 보여요" FontFamily="Consolas"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- card text -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="DescCount" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="카드 텍스트" Style="{StaticResource Heading}"/>
                        </DockPanel>
                        <TextBox x:Name="DescBox" Text="{Binding Desc, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 FontSize="15" Padding="8,6" TextChanged="DescBox_TextChanged"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent" DragCompleted="Splitter_DragCompleted"/>

            <!-- ============ right: strings and categories ============ -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}">
                            스트링 <Run Text="— 스크립트의 aux.Stringid(코드, 번호)" FontWeight="Normal" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="StringsList" ItemsSource="{Binding Strings}" KeyboardNavigation.TabNavigation="Continue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,4,5">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="26" TextAlignment="Right"
                                                       VerticalAlignment="Top" Margin="0,5,8,0" Foreground="{StaticResource Muted}" FontFamily="Consolas"/>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="StringBox_PreviewKeyDown"
                                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}">
                            효과 분류 <Run Text="— 해당하는 것을 전부 체크" FontWeight="Normal" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" Margin="0,3,8,3" Focusable="False"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
